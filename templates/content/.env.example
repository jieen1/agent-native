# Cloud database (optional - content works file-only by default)
# Set these to enable cloud sync and public sharing
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-auth-token

# AI providers
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Notion integration
# NOTION_API_KEY=

# Notion OAuth (for connecting user accounts — configure via the onboarding wizard)
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=

# Auth (production only)
# ACCESS_TOKEN=

# Media upload storage (optional — used only when Builder.io is not
# connected; falls back to local disk under ./data/uploads when unset)
# S3-compatible object storage (S3, R2, MinIO, ...). CONTENT_STORAGE_*
# vars take precedence over the generic S3_*/MINIO_* names below.
# CONTENT_STORAGE_BUCKET=
# CONTENT_STORAGE_ACCESS_KEY_ID=
# CONTENT_STORAGE_SECRET_ACCESS_KEY=
# CONTENT_STORAGE_ENDPOINT=
# CONTENT_STORAGE_REGION=
# CONTENT_STORAGE_PUBLIC_BASE_URL=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_REGION=
# S3_PUBLIC_BASE_URL=
# MINIO_BUCKET=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_ENDPOINT=
# MINIO_REGION=
# Local disk fallback directory (default: <cwd>/data/uploads)
# CONTENT_UPLOADS_DIR=
